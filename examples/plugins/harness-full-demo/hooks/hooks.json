{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/demo_hook.py",
              "pre",
              "${CLAUDE_PLUGIN_DATA}/hook-events.jsonl"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/demo_hook.py",
              "post",
              "${CLAUDE_PLUGIN_DATA}/hook-events.jsonl"
            ],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
