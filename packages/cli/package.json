{
  "name": "@za38/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "za38": "./dist/index.js",
    "harness": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --external @opentui/core --external @opentui/react --external react --external react-dom --external react-reconciler && bun run scripts/build-web-assets.ts",
    "syntax:assets": "bun run scripts/vendor-syntax-assets.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@opentui/core": "0.4.3",
    "@opentui/react": "0.4.3",
    "@za38/protocol": "workspace:*",
    "lucide-react": "1.28.0",
    "marked": "17.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-reconciler": "0.33.0",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@types/bun": "1.3.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.4",
    "@types/react-reconciler": "0.32.0",
    "happy-dom": "^20.11.1",
    "typescript": "6.0.3"
  }
}
